# Copy this file to .env and fill in the values locally.
# Never commit .env or paste the API token into chat/log output.
# Use the API key from Toggl 2.0 settings. It begins with toggl_sk_.
TOGGL_API_KEY=toggl_sk_replace_with_your_api_key
TOGGL_ORGANIZATION_ID=1234567
TOGGL_WORKSPACE_ID=1234567

# Fail-closed gate. Set true only when you want start_timer and stop_timer exposed.
TOGGL_ENABLE_WRITE_TOOLS=false

# Optional HTTP timeout in seconds. Default: 10.
TOGGL_TIMEOUT_SECONDS=10
